<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Pinned, not "latest": with TreatWarningsAsErrors on, "latest" means a newly released SDK can add
         rules and break the build for anyone who upgrades, without a line of code changing. The .NET 11 RC
         did exactly that, adding five style rules across 38 sites. Bump this deliberately. -->
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- So a consumer can step into these sources from their debugger: the pdb records where each file
         came from, and the repository URL is stamped into the package. Untracked generated sources are
         embedded rather than pointed at, since they exist nowhere a debugger could fetch them. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Package metadata shared by every project -->
    <Authors>Keith Adler and the Tenet contributors</Authors>
    <Company>Tenet</Company>
    <Product>Tenet</Product>
    <Copyright>Copyright (c) 2026 Keith Adler and the Tenet contributors</Copyright>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/keithadler/tenet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/keithadler/tenet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>lean;lean4;theorem-prover;type-checker;kernel;dependent-types;proof-checker</PackageTags>
    <VersionPrefix>0.11.1</VersionPrefix>
  </PropertyGroup>
</Project>
