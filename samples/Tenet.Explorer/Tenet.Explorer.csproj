<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- TargetFrameworks, not TargetFramework: the repo's Directory.Build.props sets the plural one,
         and an inherited plural overrides a local singular, so the singular would be ignored here.
         Both targets on purpose: this is the only place lib/net8.0 is exercised the way a consumer
         gets it, from nuget.org rather than from this repo's own build output.
         The version here trails the repo's: it must name a version that is actually published, so it
         is bumped after a release lands, not in the commit that cuts one. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>tenet-explorer</AssemblyName>
    <RootNamespace>Tenet.Explorer</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The published packages, not project references: this sample is here to show that what is on
       nuget.org is usable from an ordinary project, which a project reference would not demonstrate. -->
  <ItemGroup>
    <PackageReference Include="Tenet.Kernel" Version="0.11.0" />
    <PackageReference Include="Tenet.Olean" Version="0.11.0" />
  </ItemGroup>

</Project>
