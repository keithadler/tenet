<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>tenet</AssemblyName>
    <RootNamespace>Tenet.Cli</RootNamespace>
    <Description>Command-line checker for Lean 4 exports.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tenet</ToolCommandName>
    <IsPackable>true</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- DATAS, the GC's adaptive heap sizing, costs this workload about 30% at twelve threads: checking
         allocates expression nodes constantly and benefits from a heap that simply stays large. .NET 10 left
         it off for Server GC and .NET 11 turns it on, so leaving it unset means a runtime upgrade silently
         changes throughput. Measured on Init: 10.2 s either way with this off, 13.3 s on .NET 11 without it. -->
    <!-- (set as a runtime host option below; there is no first-class MSBuild property for it) -->
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Tenet.Kernel/Tenet.Kernel.csproj" />
    <ProjectReference Include="../Tenet.Export/Tenet.Export.csproj" />
    <ProjectReference Include="../Tenet.Olean/Tenet.Olean.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reported upstream: https://github.com/dotnet/runtime/issues/134031 -->
    <!-- Trim="true" turns this into a feature switch, and ILC rejects it with "Unexpected feature switch
         pair", so the native AOT publish fails. The release workflow falls back to a self-contained build
         when AOT fails, silently, which is how two releases shipped 32 MB binaries while the README
         promised 4 MB ones. Keep the switch everywhere else; set the option plainly for AOT. -->
    <RuntimeHostConfigurationOption Include="System.GC.DynamicAdaptationMode" Value="0" Trim="true"
                                    Condition="'$(PublishAot)' != 'true'" />
    <RuntimeHostConfigurationOption Include="System.GC.DynamicAdaptationMode" Value="0"
                                    Condition="'$(PublishAot)' == 'true'" />
  </ItemGroup>

</Project>